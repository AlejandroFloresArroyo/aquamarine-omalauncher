+
+bool Aquamarine::CWaylandOutput::shmCanRead(SP<IBuffer> buffer, const SDMABUFAttrs& ATTRS) {
+    // Our own GBM buffers only, single-plane LINEAR XRGB8888/ARGB8888: the CPU knows their layout,
+    // and the consumer hands over a fence for each frame it renders into them. Not, e.g., a client
+    // buffer the consumer wants to scan out directly.
+    return buffer && dynamic_cast<CGBMBuffer*>(buffer.get()) && ATTRS.success && ATTRS.planes == 1 && ATTRS.modifier == DRM_FORMAT_MOD_LINEAR &&
+        (ATTRS.format == DRM_FORMAT_XRGB8888 || ATTRS.format == DRM_FORMAT_ARGB8888) && ATTRS.size.x >= 1 && ATTRS.size.y >= 1 && ATTRS.fds.at(0) >= 0 &&
+        ATTRS.strides.at(0) >= (uint32_t)ATTRS.size.x * 4;
+}
+
+bool Aquamarine::CWaylandOutput::presentShm(const COutputState::SInternalState& STATE) {
+    // Only commits that set a buffer carry new pixels. Others (DPMS, mode tests, ...) leave the host
+    // showing what it has.
+    if (!(STATE.committed & COutputState::AQ_OUTPUT_STATE_BUFFER))
+        return true;
+
+    const auto ATTRS = STATE.buffer->dmabuf();
+    if (!shmCanRead(STATE.buffer, ATTRS)) {
+        backend->backend->log(AQ_LOG_ERROR,
+                              std::format("Output {}: wl_shm: cannot present this buffer ({}, modifier 0x{:x}): only this backend's LINEAR XRGB8888/ARGB8888 buffers", name,
+                                          fourccToName(ATTRS.format), ATTRS.modifier));
+        return false;
+    }
+
+    const auto W = (int32_t)ATTRS.size.x, H = (int32_t)ATTRS.size.y;
+
+    // New size or format: new wl_shm buffers, and the host needs everything. Dropping the old ones is
+    // fine even if the host still holds one, since we never write to it again.
+    if (shmState.size != ATTRS.size || shmState.format != ATTRS.format) {
+        forgetShmPending(); // replaced below, together with the frame in flight it may own
+        shmState.buffers.clear();
+        shmState.size       = ATTRS.size;
+        shmState.format     = ATTRS.format;
+        shmState.hostDamage = CRegion(0, 0, W, H);
+        shmState.unverified.clear();
+        shmState.unverifiedSource.reset();
+    }
+
+    // What this frame changed, in buffer pixels. Hyprland passes its real frame damage, which may
+    // reach past the buffer. A commit without damage counts as a full change. Pixels the previous
+    // frame copied without a fence are copied again, from this newer frame.
+    CRegion damage = (STATE.committed & COutputState::AQ_OUTPUT_STATE_DAMAGE) ? STATE.damage : CRegion(0, 0, W, H);
+    damage.add(shmState.unverified);
+    damage.intersect(0, 0, W, H);
+    shmState.unverified.clear();
+    shmState.unverifiedSource.reset();
+    WaylandShm::addFrameDamage(shmState.buffers, shmState.hostDamage, damage);
+
+    // Before the first configure is acked the host must not get a buffer. Everything stays recorded
+    // and goes out with the first frame after it.
+    if (!shmState.configured)
+        return true;
+
+    // Nothing new for the host and a wl_surface.frame in flight, whose done event continues the
+    // frame loop: nothing to send. Without one, the frame goes through advanceShm(), which
+    // re-attaches an up-to-date buffer so that the host still answers with a frame callback.
+    if (shmState.hostDamage.empty() && !shmState.pending && (sched.frameInFlight() || !shmState.presented))
+        return true;
+
+    SShmPending pending = {.source = STATE.buffer, .attrs = ATTRS, .frame = true, .since = std::chrono::steady_clock::now()};
+    if ((STATE.committed & COutputState::AQ_OUTPUT_STATE_EXPLICIT_IN_FENCE) && STATE.explicitInFence >= 0) {
+        // the snapshot's dup is closed when commit() returns: keep our own (just an fd dup, nothing
+        // is exported from the driver)
+        pending.fence = Hyprutils::OS::CFileDescriptor{fcntl(STATE.explicitInFence, F_DUPFD_CLOEXEC, 0)};
+        if (!pending.fence.isValid())
+            backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: cannot dup the frame's fence ({}), treating it as a frame without one", name, strerror(errno)));
+    }
+
+    if (pending.fence.isValid())
+        shmState.framesWithoutFence = 0;
+    else if (++shmState.framesWithoutFence == SHM_NO_FENCE_WARN_RUN) {
+        static bool warned = false;
+        if (!warned)
+            backend->backend->log(AQ_LOG_WARNING,
+                                  std::format("Output {}: wl_shm: frames arrive without an explicit fence. Presentation is not synchronized with the GPU: pixels are read "
+                                              "after DMA_BUF_IOCTL_SYNC, which only waits for fences the driver attached to the buffer, and read again one host "
+                                              "frame later",
+                                              name));
+        warned = true;
+    }
+
+    // This frame replaces a pending one: it is complete wherever the old one was, and the old one's
+    // damage is still in hostDamage and the stale regions.
+    forgetShmPending();
+    shmState.pending = std::move(pending);
+
+    // The frame is in flight until it reaches the host and its wl_surface.frame is done: no frame
+    // event and no rendering into the swapchain meanwhile.
+    if (!sched.frameInFlight())
+        sched.onFrameSubmitted();
+
+    advanceShm();
+    return true;
+}
+
+void Aquamarine::CWaylandOutput::advanceShm() {
+    if (!shmState.pending)
+        return;
+
+    auto&      P = *shmState.pending;
+    const auto W = (int32_t)shmState.size.x, H = (int32_t)shmState.size.y;
+
+    // the free wl_shm buffer brought up to date most recently (the least to copy), or a new one
+    auto buf = WaylandShm::pickFree(shmState.buffers);
+    if (!buf && shmState.buffers.size() < WaylandShm::MAX_BUFFERS) {
+        buf = createShmBuffer(shmState.size, shmState.format);
+        if (!buf) {
+            dropShmPending(false);
+            return;
+        }
+        shmState.buffers.emplace_back(buf);
+    }
+
+    if (!buf) {
+        // The host holds all our buffers. Neither block nor write into them: the next
+        // wl_buffer.release continues this frame.
+        static bool warned = false;
+        if (!warned)
+            backend->backend->log(AQ_LOG_WARNING, std::format("Output {}: wl_shm: the host holds all {} buffers, the frame waits for a release", name, shmState.buffers.size()));
+        warned = true;
+        return;
+    }
+
+    const auto RECTS = WaylandShm::clippedRects(buf->stale, W, H);
+
+    // The GPU must be done with the frame before the CPU reads it. Its fence is not waited for here:
+    // it goes into the backend's epoll set (one-shot: a signaled sync_file stays readable), and
+    // dispatchShmFDs() calls us again once it signals.
+    if (!RECTS.empty() && P.fence.isValid()) {
+        int fence = waitForSyncFile(P.fence.get(), 0);
+        if (fence == 0) {
+            if (backend->watchShmFD(P.fence.get(), EPOLLIN | EPOLLONESHOT, P.watched)) {
+                P.watched = true;
+                return;
+            }
+
+            // no epoll: wait here, bounded, and never copy a frame whose fence has not signaled
+            fence = waitForSyncFile(P.fence.get(), SHM_FENCE_TIMEOUT_MS);
+            if (fence == 0) {
+                backend->backend->log(AQ_LOG_WARNING, std::format("Output {}: wl_shm: the frame's fence did not signal within {} ms, dropping the frame", name, SHM_FENCE_TIMEOUT_MS));
+                dropShmPending(true);
+                return;
+            }
+        }
+
+        if (P.watched) {
+            backend->unwatchShmFD(P.fence.get());
+            P.watched = false;
+        }
+
+        if (fence < 0) {
+            // only an fd that is not a sync_file gets here: sync_file poll never reports errors
+            backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: cannot poll the frame's fence, treating it as a frame without one", name));
+            P.fence.reset();
+        } else if (P.warned)
+            backend->backend->log(AQ_LOG_WARNING,
+                                  std::format("Output {}: wl_shm: the frame's fence signaled after {} ms", name,
+                                              std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - P.since).count()));
+    }
+
+    if (!RECTS.empty() && !copyToShm(P, *buf, RECTS)) {
+        dropShmPending(false);
+        return;
+    }
+
+    // Pixels read without a signaled fence (the frame had none) may predate the frame: read them
+    // again a little later (armShmRecopy), or with the next frame. AQ_WAYLAND_SHM_RECOPY=1 does that
+    // for every frame, =0 never.
+    const int  RECOPY     = backend->shmPresent.recopy;
+    const bool UNVERIFIED = P.frame && !RECTS.empty() && (RECOPY == 1 || (RECOPY == -1 && !P.fence.isValid()));
+    if (UNVERIFIED) {
+        shmState.unverified.add(buf->stale);
+        shmState.unverified.intersect(0, 0, W, H);
+        shmState.unverifiedSource = P.source;
+        shmState.unverifiedAttrs  = P.attrs;
+    }
+
+    buf->stale.clear();
+    buf->syncSeq = ++shmState.seq;
+
+    waylandState.surface->sendAttach(buf->buffer.get(), 0, 0);
+
+    // wl_surface.damage (v1), not damage_buffer (v4). The host advertises wl_compositor v4, so both
+    // exist there, but this surface never changes its buffer scale (1) or transform (normal), so
+    // surface and buffer coordinates are the same, and v1 damage is what every host handles. With
+    // nothing new this is a single pixel, so the host treats it like any other frame.
+    for (const auto& r : WaylandShm::hostDamageRects(shmState.hostDamage)) {
+        waylandState.surface->sendDamage(r.x1, r.y1, r.x2 - r.x1, r.y2 - r.y1);
+    }
+
+    shmState.hostDamage.clear();
+    buf->busy          = true;
+    shmState.presented = true;
+
+    if (UNVERIFIED)
+        armShmRecopy();
+
+    // As in the dmabuf path: one wl_surface.frame in flight at a time, requested before the commit.
+    // Re-copies request none, the frame cycle they belong to has its own.
+    if (P.frame && !waylandState.frameCallback) {
+        waylandState.frameCallback = makeShared<CCWlCallback>(waylandState.surface->sendFrame());
+        waylandState.frameCallback->setDone([this](CCWlCallback* r, uint32_t ms) { onFrameDone(); });
+        sched.onFrameSubmitted();
+    }
+
+    waylandState.surface->sendCommit();
+    waylandState.surfaceSize = shmState.size;
+
+    forgetShmPending();
+
+    // We may run outside dispatchEvents: flush now, as the dmabuf path does. One sendmsg per frame.
+    wl_display_flush(backend->waylandState.display);
+}
+
+void Aquamarine::CWaylandOutput::forgetShmPending() {
+    if (!shmState.pending)
+        return;
+
+    if (shmState.pending->watched && backend)
+        backend->unwatchShmFD(shmState.pending->fence.get());
+
+    shmState.pending.reset();
+}
+
+void Aquamarine::CWaylandOutput::dropShmPending(bool rerender) {
+    // Gives up on the pending frame. Its damage stays recorded and goes out with the next frame. The
+    // frame in flight it owned ends, so that the consumer renders again on its next scheduleFrame,
+    // or right away with `rerender`.
+    if (!shmState.pending)
+        return;
+
+    const bool FRAME = shmState.pending->frame;
+    forgetShmPending();
+
+    if (FRAME && !waylandState.frameCallback)
+        sched.onFrameComplete();
+
+    if (rerender || (FRAME && needsFrame))
+        scheduleFrame(AQ_SCHEDULE_NEEDS_FRAME);
+}
+
+void Aquamarine::CWaylandOutput::recopyUnverifiedShm() {
+    // Pixels were read without a signaled fence a little while ago; the GPU is done with them by now.
+    // Read them again from the same swapchain buffer, this time after DMA_BUF_IOCTL_SYNC. The
+    // consumer has not rendered into that buffer since: it rotates through its swapchain, and the
+    // first newer frame takes the pixels over (presentShm clears `unverified` then).
+    if (shmState.unverified.empty() || shmState.pending)
+        return;
+
+    auto source = shmState.unverifiedSource;
+    auto attrs  = shmState.unverifiedAttrs;
+    auto region = shmState.unverified.copy();
+    shmState.unverified.clear();
+    shmState.unverifiedSource.reset();
+
+    if (!source || attrs.size != shmState.size || attrs.format != shmState.format)
+        return;
+
+    WaylandShm::addFrameDamage(shmState.buffers, shmState.hostDamage, region);
+    shmState.pending = SShmPending{.source = source, .attrs = attrs, .frame = false, .since = std::chrono::steady_clock::now()};
+    advanceShm();
+}
+
+void Aquamarine::CWaylandOutput::armShmRecopy() {
+    // A timer rather than the next frame callback: that one may have been requested by an earlier
+    // commit and come right away, and asking for a second one in the same commit is something a
+    // simple host may not handle. Without epoll, onFrameDone() re-copies instead.
+    if (!shmState.recopyTimer.isValid() && backend->shmPresent.epollFD.isValid()) {
+        shmState.recopyTimer = Hyprutils::OS::CFileDescriptor{timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC)};
+        if (shmState.recopyTimer.isValid() && !backend->watchShmFD(shmState.recopyTimer.get(), EPOLLIN, false))
+            shmState.recopyTimer.reset();
+    }
+
+    if (!shmState.recopyTimer.isValid())
+        return;
+
+    itimerspec when = {.it_interval = {}, .it_value = {.tv_sec = 0, .tv_nsec = SHM_RECOPY_DELAY_MS * 1000000L}};
+    if (timerfd_settime(shmState.recopyTimer.get(), 0, &when, nullptr) != 0)
+        backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: cannot arm the re-copy timer: {}", name, strerror(errno)));
+}
+
+void Aquamarine::CWaylandOutput::onShmRecopyTimer() {
+    if (!shmState.recopyTimer.isValid())
+        return;
+
+    uint64_t expirations = 0;
+    if (read(shmState.recopyTimer.get(), &expirations, sizeof(expirations)) != (ssize_t)sizeof(expirations) || expirations == 0)
+        return; // not due (non-blocking timerfd)
+
+    recopyUnverifiedShm();
+}
+
+void Aquamarine::CWaylandOutput::closeShmRecopyTimer() {
+    if (!shmState.recopyTimer.isValid())
+        return;
+
+    if (backend)
+        backend->unwatchShmFD(shmState.recopyTimer.get());
+
+    shmState.recopyTimer.reset();
+}
+
+void Aquamarine::CWaylandOutput::checkShmFenceAge() {
+    // Runs on host traffic: catches a fence wakeup that went missing, and logs a fence that takes
+    // very long (a GPU that hangs keeps the frame, and the session's output, waiting).
+    if (!shmState.pending || !shmState.pending->watched)
+        return;
+
+    if (waitForSyncFile(shmState.pending->fence.get(), 0) != 0) {
+        advanceShm();
+        return;
+    }
+
+    auto&      P  = *shmState.pending;
+    const auto MS = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - P.since).count();
+    if (P.warned || MS < SHM_FENCE_SLOW_MS)
+        return;
+
+    P.warned = true;
+    backend->backend->log(AQ_LOG_WARNING, std::format("Output {}: wl_shm: the frame's GPU fence has not signaled after {} ms, still waiting", name, MS));
+}
+
+bool Aquamarine::CWaylandOutput::copyToShm(const SShmPending& P, SShmBuffer& dst, const std::vector<pixman_box32_t>& RECTS) {
+    // Read through gbm_bo_map (default: the path verified on the target) or, with
+    // AQ_WAYLAND_SHM_MMAP=1, through a persistent mmap of the dmabuf.
+    const auto SOURCE = backend->shmPresent.mmapSources ? shmSourceFor(P.source, P.attrs) : nullptr;
+    const bool DIRECT = SOURCE && SOURCE->data;
+
+    // DMA_BUF_IOCTL_SYNC around the read. By default: for frames without a fence (START waits for
+    // implicit fences, if the producer attached any), for re-copies, and around reads through the
+    // dmabuf mmap, which the dma-buf uAPI requires for cache coherency (gbm_bo_map does its own).
+    // AQ_WAYLAND_SHM_DMABUF_SYNC=1 always, =0 never.
+    const int  MODE  = backend->shmPresent.dmabufSync;
+    const bool SYNC  = MODE == 1 || (MODE == -1 && (!P.fence.isValid() || !P.frame || DIRECT));
+    const int  FD    = P.attrs.fds.at(0);
+    bool       begun = false;
+    if (SYNC) {
+        begun = syncDmabuf(FD, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+        if (!begun)
+            TRACE(backend->backend->log(AQ_LOG_TRACE, std::format("Output {}: wl_shm: DMA_BUF_IOCTL_SYNC failed: {}", name, strerror(errno))));
+    }
+
+    const uint8_t* src       = nullptr;
+    size_t         srcStride = 0;
+    bool           gbmMapped = false;
+    if (DIRECT) {
+        src       = SOURCE->data + P.attrs.offsets.at(0);
+        srcStride = P.attrs.strides.at(0);
+    } else if (const auto [ptr, fmt, len] = P.source->beginDataPtr(GBM_BO_TRANSFER_READ); ptr) {
+        src       = ptr;
+        srcStride = len / (size_t)P.attrs.size.y;
+        gbmMapped = true;
+    }
+
+    const bool OK = src && srcStride >= (size_t)P.attrs.size.x * 4;
+    if (OK)
+        WaylandShm::copyRects(dst.data, dst.stride, src, srcStride, RECTS);
+
+    if (gbmMapped)
+        P.source->endDataPtr();
+    if (begun)
+        syncDmabuf(FD, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+
+    if (!OK)
+        backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: cannot map the rendered buffer for reading", name));
+
+    return OK;
+}
+
+SP<CWaylandOutput::SShmSource> Aquamarine::CWaylandOutput::shmSourceFor(SP<IBuffer> buffer, const SDMABUFAttrs& ATTRS) {
+    // forget buffers that are gone or left the swapchain, so their mappings don't pin GPU memory
+    std::erase_if(shmState.sources, [this, &buffer](const auto& s) {
+        const auto B = s->buffer.lock();
+        return !B || (B != buffer && (!swapchain || !swapchain->contains(B)));
+    });
+
+    for (auto const& s : shmState.sources) {
+        if (s->buffer == buffer)
+            return s;
+    }
+
+    auto source    = makeShared<SShmSource>();
+    source->buffer = buffer;
+    shmState.sources.emplace_back(source);
+
+    // A read-only mapping of the dmabuf itself, kept for the buffer's lifetime (no per-frame map and
+    // unmap). Only for single-plane LINEAR buffers. Otherwise, or if the kernel refuses, data stays
+    // null and copyToShm() reads through gbm_bo_map.
+    if (!backend->shmPresent.mmapSources || ATTRS.planes != 1 || ATTRS.modifier != DRM_FORMAT_MOD_LINEAR)
+        return source;
+
+    const int    FD   = ATTRS.fds.at(0);
+    const size_t NEED = (size_t)ATTRS.offsets.at(0) + (size_t)ATTRS.strides.at(0) * ((size_t)ATTRS.size.y - 1) + (size_t)ATTRS.size.x * 4;
+    const off_t  END  = lseek(FD, 0, SEEK_END); // dmabufs report their size this way
+    lseek(FD, 0, SEEK_SET);
+    const size_t LEN = END > 0 ? (size_t)END : NEED;
+
+    if (LEN < NEED) {
+        backend->backend->log(AQ_LOG_WARNING, std::format("Output {}: wl_shm: dmabuf smaller than its layout ({} < {}), reading it through gbm_bo_map", name, LEN, NEED));
+        return source;
+    }
+
+    void* map = mmap(nullptr, LEN, PROT_READ, MAP_SHARED, FD, 0);
+    if (map == MAP_FAILED) {
+        backend->backend->log(AQ_LOG_WARNING, std::format("Output {}: wl_shm: cannot mmap a rendered buffer ({}), reading it through gbm_bo_map", name, strerror(errno)));
+        return source;
+    }
+
+    source->data = (uint8_t*)map;
+    source->size = LEN;
+    return source;
+}
+
+SP<CWaylandOutput::SShmBuffer> Aquamarine::CWaylandOutput::createShmBuffer(const Vector2D& size, uint32_t format) {
+    const auto   W      = (int32_t)size.x, H = (int32_t)size.y;
+    const auto   STRIDE = W * 4;
+    const size_t LEN    = (size_t)STRIDE * (size_t)H;
+
+    if (LEN > INT32_MAX) {
+        backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: {}x{} is too large for a wl_shm pool", name, W, H));
+        return nullptr;
+    }
+
+    // memfd, sealed against shrinking (which would make the host's reads fault); shm_open as a fallback
+    int fd = memfd_create("aquamarine-wl_shm", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    if (fd >= 0) {
+        int ret = 0;
+        do {
+            ret = ftruncate(fd, LEN);
+        } while (ret < 0 && errno == EINTR);
+
+        if (ret < 0) {
+            close(fd);
+            fd = -1;
+        } else
+            fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK);
+    }
+
+    if (fd < 0)
+        fd = allocateSHMFile(LEN);
+
+    if (fd < 0) {
+        backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: failed to allocate {} bytes of shared memory", name, LEN));
+        return nullptr;
+    }
+
+    void* data = mmap(nullptr, LEN, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED) {
+        backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: failed to mmap shared memory: {}", name, strerror(errno)));
+        close(fd);
+        return nullptr;
+    }
+
+    auto buf    = makeShared<SShmBuffer>();
+    buf->data   = (uint8_t*)data;
+    buf->size   = LEN;
+    buf->stride = STRIDE;
+    buf->stale  = CRegion(0, 0, W, H); // holds no frame yet
+
+    // libwayland dups the fd while marshalling, so ours can be closed right away
+    buf->pool = makeShared<CCWlShmPool>(backend->waylandState.shm->sendCreatePool(fd, (int32_t)LEN));
+    close(fd);
+
+    if (!buf->pool->resource()) {
+        backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: failed to create a pool", name));
+        return nullptr;
+    }
+
+    buf->buffer = makeShared<CCWlBuffer>(buf->pool->sendCreateBuffer(0, W, H, STRIDE, shmFormatFromDRM(format)));
+
+    if (!buf->buffer->resource()) {
+        backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: failed to create a buffer", name));
+        return nullptr;
+    }
+
+    buf->buffer->setRelease([this, raw = buf.get()](CCWlBuffer* r) {
+        raw->busy = false;
+        advanceShm(); // a frame may be waiting for a free buffer
+    });
+
+    backend->backend->log(AQ_LOG_DEBUG,
+                          std::format("Output {}: wl_shm: new {}x{} {} buffer ({} of at most {})", name, W, H, fourccToName(format), shmState.buffers.size() + 1,
+                                      WaylandShm::MAX_BUFFERS));
+    return buf;
+}
diff --git a/src/backend/WaylandShm.hpp b/src/backend/WaylandShm.hpp
new file mode 100644
index 0000000..775fd83
--- /dev/null
+++ b/src/backend/WaylandShm.hpp
@@ -0,0 +1,96 @@
+#pragma once
+
+// CPU-side helpers for the Wayland backend's wl_shm presentation path (see
+// CWaylandOutput::presentShm in Wayland.cpp). Nothing in here talks to Wayland
+// or the GPU, so a test can drive it with plain memory.
+//
+// Bookkeeping used by presentShm, per output:
+//  - every wl_shm buffer has a `stale` region: pixels that are older than the
+//    newest frame. A new buffer is entirely stale. Presenting into a buffer
+//    copies only its stale rectangles from the rendered frame, after which the
+//    buffer equals the frame.
+//  - `hostDamage` holds every pixel that changed since the host last copied
+//    from us. It is sent as wl_surface.damage and then cleared. Each buffer's
+//    stale region always contains hostDamage, so the attached buffer is
+//    correct wherever the host looks.
+//  - pixels read without a signaled GPU fence are "unverified": they are added
+//    to the stale regions and hostDamage again one host frame later and read
+//    again from the same rendered buffer (or from the next frame, if it comes
+//    first).
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+#include <hyprutils/math/Region.hpp>
+
+namespace Aquamarine::WaylandShm {
+    // wl_shm buffers per output. The host normally returns a buffer right after copying it, so
+    // one is in use and a second one covers a late release. If all of them are held, the frame
+    // waits for a release rather than overwriting memory the host may still read.
+    constexpr size_t MAX_BUFFERS = 3;
+
+    // Above this many rectangles, damage the host with the bounding box instead. This is always
+    // correct: the attached buffer is complete, so extra damage only makes the host copy more.
+    constexpr size_t MAX_DAMAGE_RECTS = 32;
+
+    // `region` clipped to a w x h buffer, as rectangles in buffer pixels.
+    inline std::vector<pixman_box32_t> clippedRects(const Hyprutils::Math::CRegion& region, int32_t w, int32_t h) {
+        auto clipped = region.copy();
+        clipped.intersect(0, 0, w, h);
+        return clipped.getRects();
+    }
+
+    // Copies `rects` of a 32 bpp image from src to dst. Both have their origin top-left; strides
+    // are in bytes. Each rect must lie inside both images. Returns the number of bytes copied.
+    inline size_t copyRects(uint8_t* dst, size_t dstStride, const uint8_t* src, size_t srcStride, const std::vector<pixman_box32_t>& rects) {
+        size_t copied = 0;
+        for (const auto& r : rects) {
+            if (r.x2 <= r.x1 || r.y2 <= r.y1)
+                continue;
+
+            const size_t X   = (size_t)r.x1 * 4;
+            const size_t LEN = (size_t)(r.x2 - r.x1) * 4;
+            for (int32_t y = r.y1; y < r.y2; ++y) {
+                memcpy(dst + (size_t)y * dstStride + X, src + (size_t)y * srcStride + X, LEN);
+            }
+            copied += LEN * (size_t)(r.y2 - r.y1);
+        }
+        return copied;
+    }
+
+    // A new frame changed `damage` (buffer pixels, already clipped). This makes those pixels stale
+    // in every buffer, including ones the host still holds, and pending for the host.
+    template <typename BUFFERS>
+    void addFrameDamage(BUFFERS& buffers, Hyprutils::Math::CRegion& hostDamage, const Hyprutils::Math::CRegion& damage) {
+        for (auto& b : buffers) {
+            b->stale.add(damage);
+        }
+        hostDamage.add(damage);
+    }
+
+    // Picks a buffer to present into: among those the host has released, the one brought up to
+    // date most recently, which has the least to copy. Returns an empty value if the host holds
+    // all of them.
+    template <typename BUFFERS>
+    typename BUFFERS::value_type pickFree(BUFFERS& buffers) {
+        typename BUFFERS::value_type best{};
+        for (auto& b : buffers) {
+            if (!b->busy && (!best || b->syncSeq > best->syncSeq))
+                best = b;
+        }
+        return best;
+    }
+
+    // The rectangles to send as wl_surface.damage for `region`. An empty region (a commit that only
+    // keeps the frame loop going, re-attaching an up-to-date buffer) still gets one pixel, so that
+    // the host handles it like any other frame. That pixel is current in the attached buffer.
+    inline std::vector<pixman_box32_t> hostDamageRects(const Hyprutils::Math::CRegion& region) {
+        auto rects = region.getRects();
+        if (rects.empty())
+            return {pixman_box32_t{.x1 = 0, .y1 = 0, .x2 = 1, .y2 = 1}};
+        if (rects.size() <= MAX_DAMAGE_RECTS)
+            return rects;
+        return {*pixman_region32_extents(region.pixman())};
+    }
+}
