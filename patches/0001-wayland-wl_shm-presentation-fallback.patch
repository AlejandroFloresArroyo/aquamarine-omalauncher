+// -------------------------------------------------------------------------------------------------
+// wl_shm presentation
+//
+// Used when the host has no zwp_linux_dmabuf_v1 (or with AQ_WAYLAND_SHM_PRESENT=1). The consumer
+// still renders on the GPU, into our GBM swapchain buffers (LINEAR, see initShmPresentation).
+//
+// commit() records what the frame changed and makes it the pending frame (presentShm). advanceShm()
+// copies the changed pixels into a wl_shm buffer, attaches that and commits, once
+//  - the frame's GPU fence has signaled. Nothing blocks on it: the fence goes into the backend's
+//    epoll set, whose fd the consumer polls with the others, and dispatchShmFDs() continues;
+//  - a wl_shm buffer is free. Otherwise the next wl_buffer.release continues.
+// Until the commit's wl_surface.frame is done the frame stays in flight, so the consumer gets no
+// frame event and does not render into its swapchain again. A newer frame replaces a pending one:
+// it is complete wherever the old one was, and the old one's damage stays recorded.
+// A frame without a fence is copied right away, after DMA_BUF_IOCTL_SYNC; what it copied is read
+// again a little later (recopyUnverifiedShm), when the GPU is surely done.
+// WaylandShm.hpp describes the damage bookkeeping.
+// -------------------------------------------------------------------------------------------------
+
+constexpr int    SHM_FENCE_TIMEOUT_MS  = 1000; // only without epoll, where commit() has to wait
+constexpr int    SHM_FENCE_SLOW_MS     = 1000; // log fences that take longer than this
+constexpr long   SHM_RECOPY_DELAY_MS   = 25;   // re-copy of pixels read without a fence: a couple of host frames (90 Hz) later
+constexpr size_t SHM_NO_FENCE_WARN_RUN = 3;    // consecutive frames without a fence before warning (a modeset has none)
+
+// Waits up to timeoutMs (0: just looks) for a sync_file: 1 signaled, 0 not yet, -1 error. An
+// interrupted wait continues with what is left of the timeout.
+static int waitForSyncFile(int fd, int timeoutMs) {
+    const auto DEADLINE = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeoutMs);
+    for (int i = 0; i < 64; ++i) {
+        const auto LEFT = std::max<int64_t>(0, std::chrono::duration_cast<std::chrono::milliseconds>(DEADLINE - std::chrono::steady_clock::now()).count());
+        pollfd     pfd  = {.fd = fd, .events = POLLIN, .revents = 0};
+        const int  RET  = poll(&pfd, 1, (int)LEFT);
+        if (RET > 0)
+            return (pfd.revents & (POLLERR | POLLNVAL)) || !(pfd.revents & POLLIN) ? -1 : 1;
+        if (RET == 0)
+            return 0;
+        if (errno != EINTR && errno != EAGAIN)
+            return -1;
+    }
+    return 0;
+}
+
+// DMA_BUF_IOCTL_SYNC: START waits for the implicit fences of writers (only those the producer
+// attached by then) and makes the CPU's view of the buffer coherent; END closes the access.
+static bool syncDmabuf(int fd, uint64_t flags) {
+    dma_buf_sync sync = {.flags = flags};
+    for (int i = 0; i < 16; ++i) {
+        if (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) == 0)
+            return true;
+        if (errno != EINTR && errno != EAGAIN)
+            return false;
+    }
+    return false;
+}
