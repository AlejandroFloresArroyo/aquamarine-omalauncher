+bool Aquamarine::CWaylandBackend::shmPresentation() const {
+    return shmPresent.enabled;
+}
+
+bool Aquamarine::CWaylandBackend::initShmPresentation(const std::string& reason) {
+    // The render node for the GBM allocator and for the consumer's renderer (via drmFD()). On a
+    // dmabuf host (forced mode) keep its main device unless AQ_WAYLAND_RENDER_NODE says otherwise.
+    const char* envNode = getenv("AQ_WAYLAND_RENDER_NODE");
+    if (drmState.fd < 0 || (envNode && *envNode)) {
+        const std::string NODE = envNode && *envNode ? envNode : "/dev/dri/renderD128";
+
+        // Only ever open render nodes (DRM char major 226, minor >= 128): primary nodes
+        // (/dev/dri/card*) may drive the real display, e.g. Android's on phones.
+        struct stat st;
+        if (stat(NODE.c_str(), &st) != 0 || !S_ISCHR(st.st_mode) || major(st.st_rdev) != 226 || minor(st.st_rdev) < 128) {
+            backend->log(AQ_LOG_ERROR, std::format("Wayland backend cannot start: {} is not a DRM render node (see AQ_WAYLAND_RENDER_NODE)", NODE));
+            return false;
+        }
+
+        const int FD = open(NODE.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+        if (FD < 0) {
+            backend->log(AQ_LOG_ERROR, std::format("Wayland backend cannot start: failed to open render node {}: {}", NODE, strerror(errno)));
+            return false;
+        }
+
+        if (drmState.fd >= 0)
+            close(drmState.fd);
+
+        drmState.fd       = FD;
+        drmState.nodeName = NODE;
+    }
+
+    // The CPU reads these buffers, so their layout must be known: LINEAR only, and only formats
+    // whose wl_shm twins have the same byte layout (wl_shm XRGB8888/ARGB8888 = DRM XRGB8888/ARGB8888).
+    shmPresent.formats = {
+        SDRMFormat{.drmFormat = DRM_FORMAT_XRGB8888, .modifiers = {DRM_FORMAT_MOD_LINEAR}},
+        SDRMFormat{.drmFormat = DRM_FORMAT_ARGB8888, .modifiers = {DRM_FORMAT_MOD_LINEAR}},
+    };
+    const auto TRISTATE = [](const char* name) { return envEnabled(name) ? 1 : (envExplicitlyDisabled(name) ? 0 : -1); };
+    shmPresent.dmabufSync  = TRISTATE("AQ_WAYLAND_SHM_DMABUF_SYNC");
+    shmPresent.recopy      = TRISTATE("AQ_WAYLAND_SHM_RECOPY");
+    shmPresent.mmapSources = envEnabled("AQ_WAYLAND_SHM_MMAP"); // opt-in: gbm_bo_map is the path verified on real hardware
+    shmPresent.enabled     = true;
+
+    // Frames wait for their GPU fence without blocking the consumer: the fence goes into this epoll
+    // set, whose fd the consumer polls with the others (pollFDs()). Without it, commit() blocks.
+    shmPresent.epollFD = Hyprutils::OS::CFileDescriptor{epoll_create1(EPOLL_CLOEXEC)};
+    if (!shmPresent.epollFD.isValid())
+        backend->log(AQ_LOG_WARNING, std::format("Wayland backend: epoll_create1 failed ({}), wl_shm frames will wait for the GPU synchronously", strerror(errno)));
+
+    backend->log(AQ_LOG_WARNING,
+                 std::format("Wayland backend: presenting through wl_shm copies ({}). Rendering on {}, buffers LINEAR XRGB8888/ARGB8888, no hardware cursor, reading "
+                             "through {}",
+                             reason, drmState.nodeName, shmPresent.mmapSources ? "mmap of the dmabuf (AQ_WAYLAND_SHM_MMAP=1)" : "gbm_bo_map"));
+    return true;
+}
+
+bool Aquamarine::CWaylandBackend::watchShmFD(int fd, uint32_t events, bool modify) {
+    if (!shmPresent.epollFD.isValid())
+        return false;
+
+    epoll_event ev = {.events = events, .data = {.fd = fd}};
+    if (epoll_ctl(shmPresent.epollFD.get(), modify ? EPOLL_CTL_MOD : EPOLL_CTL_ADD, fd, &ev) == 0)
+        return true;
+
+    backend->log(AQ_LOG_WARNING, std::format("Wayland backend: epoll_ctl failed for a wl_shm fd: {}", strerror(errno)));
+    return false;
+}
+
+void Aquamarine::CWaylandBackend::unwatchShmFD(int fd) {
+    // explicit removal: for a fence, the consumer holds other fds of the same sync_file, so closing
+    // ours would not take it out of the epoll set
+    if (shmPresent.epollFD.isValid())
+        epoll_ctl(shmPresent.epollFD.get(), EPOLL_CTL_DEL, fd, nullptr);
+}
+
+void Aquamarine::CWaylandBackend::dispatchShmFDs() {
+    // drain the ready list (fences are one-shot; timers are read below), then let each output look
+    // at its own fence and timer
+    epoll_event events[8];
+    for (int i = 0; i < 16; ++i) {
+        const int N = epoll_wait(shmPresent.epollFD.get(), events, 8, 0);
+        if (N < 8 && !(N < 0 && errno == EINTR))
+            break;
+    }
+
+    auto outs = outputs; // neither call changes the list, but stay safe
+    for (auto const& o : outs) {
+        o->onShmRecopyTimer();
+        o->advanceShm();
+    }
+}
