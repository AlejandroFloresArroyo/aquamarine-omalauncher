From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlejandroFloresArroyo
 <26047316+AlejandroFloresArroyo@users.noreply.github.com>
Date: Mon, 12 Oct 2026 01:55:35 -0600
Subject: [PATCH] wayland: optional wl_shm presentation timings
 (AQ_WAYLAND_SHM_STATS=1)

Logs every 5 s, at debug level, how many frames went to the host, how
long they waited from commit until the copy could start (the GPU fence,
plus any wait for a free wl_shm buffer), how long mapping and copying
took, and how many pixels were copied per frame. Off by default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/env.md                            |  1 +
 include/aquamarine/backend/Wayland.hpp | 10 +++++
 src/backend/Wayland.cpp                | 58 ++++++++++++++++++++++++++
 3 files changed, 69 insertions(+)

diff --git a/docs/env.md b/docs/env.md
index 50a1108..9ffd370 100644
--- a/docs/env.md
+++ b/docs/env.md
@@ -24,3 +24,4 @@ Unless specified otherwise, a variable is enabled if and only if it's set to `1`
 `AQ_WAYLAND_SHM_MMAP` -> In wl_shm mode, `1` reads rendered buffers through a direct mmap of the dmabuf instead of `gbm_bo_map` (the default).
 `AQ_WAYLAND_SHM_DMABUF_SYNC` -> In wl_shm mode, bracket reads with `DMA_BUF_IOCTL_SYNC`: unset for frames without a fence, re-copies and direct mmap reads; `1` always; `0` never.
 `AQ_WAYLAND_SHM_RECOPY` -> In wl_shm mode, read pixels again one host frame later: unset only for frames without a fence; `1` every frame; `0` never.
+`AQ_WAYLAND_SHM_STATS` -> In wl_shm mode, `1` logs every 5 s how long frames wait for the GPU, how long mapping and copying take, and how much is copied.
diff --git a/include/aquamarine/backend/Wayland.hpp b/include/aquamarine/backend/Wayland.hpp
index 18273de..891e025 100644
--- a/include/aquamarine/backend/Wayland.hpp
+++ b/include/aquamarine/backend/Wayland.hpp
@@ -96,6 +96,7 @@ namespace Aquamarine {
             bool                                       frame   = true;  // a consumer frame, which owns the frame in flight (false: a re-copy)
             bool                                       watched = false; // fence is in the backend's epoll set
             bool                                       warned  = false; // slow fence already logged
+            bool                                       waited  = false; // counted in stats.bufferWaits
             std::chrono::steady_clock::time_point      since;
         };
 
@@ -108,6 +109,7 @@ namespace Aquamarine {
         void                                          onShmRecopyTimer();
         void                                          closeShmRecopyTimer();
         void                                          checkShmFenceAge();
+        void                                          reportShmStats();
         bool                                          shmCanRead(Hyprutils::Memory::CSharedPointer<IBuffer> buffer, const SDMABUFAttrs& attrs);
         bool                                          copyToShm(const SShmPending& pending, SShmBuffer& dst, const std::vector<pixman_box32_t>& rects);
         Hyprutils::Memory::CSharedPointer<SShmBuffer> createShmBuffer(const Hyprutils::Math::Vector2D& size, uint32_t format);
@@ -131,6 +133,13 @@ namespace Aquamarine {
             SDMABUFAttrs                               unverifiedAttrs;
             Hyprutils::OS::CFileDescriptor             recopyTimer; // timerfd in the backend's epoll set
             size_t                                     framesWithoutFence = 0;
+            // AQ_WAYLAND_SHM_STATS=1: timings, logged every few seconds (reportShmStats)
+            struct {
+                std::chrono::steady_clock::time_point since;
+                size_t                                frames = 0, fenced = 0, copies = 0, bufferWaits = 0;
+                uint64_t                              pixels  = 0;
+                double                                readyMs = 0, readyMax = 0, mapMs = 0, mapMax = 0, copyMs = 0, copyMax = 0;
+            } stats;
             std::optional<Hyprutils::Math::Vector2D>   pendingConfigure; // xdg_toplevel size, applied after the ack
         } shmState;
 
@@ -281,6 +290,7 @@ namespace Aquamarine {
             int                            dmabufSync  = -1;    // AQ_WAYLAND_SHM_DMABUF_SYNC: -1 auto (see copyToShm), 0 never, 1 always
             bool                           mmapSources = false; // AQ_WAYLAND_SHM_MMAP=1: read through a direct mmap of the dmabuf, not gbm_bo_map
             int                            recopy      = -1;    // AQ_WAYLAND_SHM_RECOPY: -1 frames without a fence, 0 never, 1 every frame
+            bool                           stats       = false; // AQ_WAYLAND_SHM_STATS=1: log presentation timings
             Hyprutils::OS::CFileDescriptor epollFD;             // fences of pending frames and re-copy timers, polled by the consumer
         } shmPresent;
 
diff --git a/src/backend/Wayland.cpp b/src/backend/Wayland.cpp
index 5b37241..770406f 100644
--- a/src/backend/Wayland.cpp
+++ b/src/backend/Wayland.cpp
@@ -577,6 +577,7 @@ bool Aquamarine::CWaylandBackend::initShmPresentation(const std::string& reason)
     const auto TRISTATE = [](const char* name) { return envEnabled(name) ? 1 : (envExplicitlyDisabled(name) ? 0 : -1); };
     shmPresent.dmabufSync  = TRISTATE("AQ_WAYLAND_SHM_DMABUF_SYNC");
     shmPresent.recopy      = TRISTATE("AQ_WAYLAND_SHM_RECOPY");
+    shmPresent.stats       = envEnabled("AQ_WAYLAND_SHM_STATS");
     shmPresent.mmapSources = envEnabled("AQ_WAYLAND_SHM_MMAP"); // opt-in: gbm_bo_map is the path verified on real hardware
     shmPresent.enabled     = true;
 
@@ -1333,6 +1334,10 @@ void Aquamarine::CWaylandOutput::advanceShm() {
     if (!buf) {
         // The host holds all our buffers. Neither block nor write into them: the next
         // wl_buffer.release continues this frame.
+        if (!P.waited) {
+            P.waited = true;
+            shmState.stats.bufferWaits++;
+        }
         static bool warned = false;
         if (!warned)
             backend->backend->log(AQ_LOG_WARNING, std::format("Output {}: wl_shm: the host holds all {} buffers, the frame waits for a release", name, shmState.buffers.size()));
@@ -1377,6 +1382,17 @@ void Aquamarine::CWaylandOutput::advanceShm() {
                                               std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - P.since).count()));
     }
 
+    if (backend->shmPresent.stats && P.frame) {
+        const double MS = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - P.since).count();
+        shmState.stats.readyMs += MS;
+        shmState.stats.readyMax = std::max(shmState.stats.readyMax, MS);
+        shmState.stats.frames++;
+        shmState.stats.fenced += P.fence.isValid();
+        for (const auto& r : RECTS) {
+            shmState.stats.pixels += (uint64_t)(r.x2 - r.x1) * (uint64_t)(r.y2 - r.y1);
+        }
+    }
+
     if (!RECTS.empty() && !copyToShm(P, *buf, RECTS)) {
         dropShmPending(false);
         return;
@@ -1429,6 +1445,33 @@ void Aquamarine::CWaylandOutput::advanceShm() {
 
     // We may run outside dispatchEvents: flush now, as the dmabuf path does. One sendmsg per frame.
     wl_display_flush(backend->waylandState.display);
+
+    if (backend->shmPresent.stats)
+        reportShmStats();
+}
+
+void Aquamarine::CWaylandOutput::reportShmStats() {
+    // AQ_WAYLAND_SHM_STATS=1: where a frame's time goes, every 5 s. "Commit to copy" is the GPU
+    // (fence) plus any wait for a free buffer; "map" is gbm_bo_map/unmap or DMA_BUF_IOCTL_SYNC.
+    auto&      S   = shmState.stats;
+    const auto NOW = std::chrono::steady_clock::now();
+    if (S.since == std::chrono::steady_clock::time_point{}) {
+        S.since = NOW;
+        return;
+    }
+
+    const double SECS = std::chrono::duration<double>(NOW - S.since).count();
+    if (SECS < 5.0)
+        return;
+
+    const double FRAMES = std::max<size_t>(S.frames, 1), COPIES = std::max<size_t>(S.copies, 1);
+    backend->backend->log(AQ_LOG_DEBUG,
+                          std::format("Output {}: wl_shm stats, last {:.1f} s: {} frames ({:.1f}/s, {} with a fence), {} waits for a free buffer; commit to copy avg "
+                                      "{:.1f} ms, max {:.1f}; map avg {:.2f} ms, max {:.1f}; copy avg {:.2f} ms, max {:.1f}, {:.3f} Mpx per frame",
+                                      name, SECS, S.frames, S.frames / SECS, S.fenced, S.bufferWaits, S.readyMs / FRAMES, S.readyMax, S.mapMs / COPIES, S.mapMax,
+                                      S.copyMs / COPIES, S.copyMax, S.pixels / FRAMES / 1e6));
+    S       = {};
+    S.since = NOW;
 }
 
 void Aquamarine::CWaylandOutput::forgetShmPending() {
@@ -1553,6 +1596,7 @@ bool Aquamarine::CWaylandOutput::copyToShm(const SShmPending& P, SShmBuffer& dst
     const bool SYNC  = MODE == 1 || (MODE == -1 && (!P.fence.isValid() || !P.frame || DIRECT));
     const int  FD    = P.attrs.fds.at(0);
     bool       begun = false;
+    const auto T0    = std::chrono::steady_clock::now();
     if (SYNC) {
         begun = syncDmabuf(FD, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
         if (!begun)
@@ -1572,14 +1616,28 @@ bool Aquamarine::CWaylandOutput::copyToShm(const SShmPending& P, SShmBuffer& dst
     }
 
     const bool OK = src && srcStride >= (size_t)P.attrs.size.x * 4;
+    const auto T1 = std::chrono::steady_clock::now();
     if (OK)
         WaylandShm::copyRects(dst.data, dst.stride, src, srcStride, RECTS);
+    const auto T2 = std::chrono::steady_clock::now();
 
     if (gbmMapped)
         P.source->endDataPtr();
     if (begun)
         syncDmabuf(FD, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
 
+    if (backend->shmPresent.stats && OK) {
+        const auto   T3   = std::chrono::steady_clock::now();
+        const double MAP  = std::chrono::duration<double, std::milli>((T1 - T0) + (T3 - T2)).count();
+        const double COPY = std::chrono::duration<double, std::milli>(T2 - T1).count();
+        auto&        S    = shmState.stats;
+        S.copies++;
+        S.mapMs += MAP;
+        S.mapMax = std::max(S.mapMax, MAP);
+        S.copyMs += COPY;
+        S.copyMax = std::max(S.copyMax, COPY);
+    }
+
     if (!OK)
         backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: wl_shm: cannot map the rendered buffer for reading", name));
 
