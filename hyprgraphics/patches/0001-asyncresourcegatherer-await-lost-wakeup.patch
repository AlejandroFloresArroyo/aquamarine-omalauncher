From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlejandroFloresArroyo
 <26047316+AlejandroFloresArroyo@users.noreply.github.com>
Date: Mon, 12 Oct 2026 02:27:25 -0600
Subject: [PATCH] asyncResourceGatherer: fix two lost wakeups (await() could
 block forever)

1. await() created awaitingCv and then waited for awaitingEvent, but the
   gather thread only set awaitingEvent (without holding awaitingMtx) when
   awaitingCv already existed. When the gather thread rendered the resource
   before the caller reached await(), which is a plain race since callers
   enqueue() and await() back to back, awaitingEvent was never set and
   await() blocked forever. Now awaitingEvent is always set and notified
   under awaitingMtx, and await() checks it under the same mutex before
   creating the condition variable and waiting.

2. wakeUpMainThread() set needsToProcess and notified without holding
   requestMutex, so the notification could fall between the gather
   thread's predicate check and its wait; the gather thread then slept for
   its 5 s wait_for timeout with the caller of await() blocked behind it.
   needsToProcess and exit are now written under requestMutex, and exit is
   only read under it.

Hyprland 0.56.2 hit the first one in IHyprRenderer::renderText() from the
debug overlay: the main thread sat in await() while the gather thread
waited for new work. renderText() is also used for notifications, the
error bar, group bar titles and the lock screen text.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/resource/AsyncResourceGatherer.cpp | 33 +++++++++++++++++++++-----
 1 file changed, 27 insertions(+), 6 deletions(-)

diff --git a/src/resource/AsyncResourceGatherer.cpp b/src/resource/AsyncResourceGatherer.cpp
index 7e3e7de..3512493 100644
--- a/src/resource/AsyncResourceGatherer.cpp
+++ b/src/resource/AsyncResourceGatherer.cpp
@@ -8,7 +8,10 @@ CAsyncResourceGatherer::CAsyncResourceGatherer() {
 }
 
 CAsyncResourceGatherer::~CAsyncResourceGatherer() {
-    m_asyncLoopState.exit = true;
+    {
+        std::lock_guard<std::mutex> lg(m_asyncLoopState.requestMutex);
+        m_asyncLoopState.exit = true;
+    }
     wakeUpMainThread();
 
     if (m_gatherThread.joinable())
@@ -16,7 +19,13 @@ CAsyncResourceGatherer::~CAsyncResourceGatherer() {
 }
 
 void CAsyncResourceGatherer::wakeUpMainThread() {
-    m_asyncLoopState.needsToProcess = true;
+    {
+        // Under requestMutex: the gather thread checks needsToProcess under it before it blocks, so the
+        // notification can't fall between that check and the wait (which then slept up to 5 s, with
+        // the caller of await() blocked behind it).
+        std::lock_guard<std::mutex> lg(m_asyncLoopState.requestMutex);
+        m_asyncLoopState.needsToProcess = true;
+    }
     m_asyncLoopState.requestsCV.notify_all();
 }
 
@@ -30,14 +39,20 @@ void CAsyncResourceGatherer::enqueue(Hyprutils::Memory::CAtomicSharedPointer<IAs
 }
 
 void CAsyncResourceGatherer::await(Hyprutils::Memory::CAtomicSharedPointer<IAsyncResource> resource) {
-    resource->m_impl->awaitingCv = Hyprutils::Memory::makeUnique<std::condition_variable>();
     std::unique_lock<std::mutex> lk(resource->m_impl->awaitingMtx);
+
+    // The gather thread may have rendered the resource already (it sets awaitingEvent under this mutex
+    // whether or not anybody waits): then there is nothing to wait for.
+    if (resource->m_impl->awaitingEvent)
+        return;
+
+    resource->m_impl->awaitingCv = Hyprutils::Memory::makeUnique<std::condition_variable>();
     resource->m_impl->awaitingCv->wait(lk, [&resource] { return resource->m_impl->awaitingEvent; });
     resource->m_impl->awaitingCv.reset();
 }
 
 void CAsyncResourceGatherer::asyncAssetSpinLock() {
-    while (!m_asyncLoopState.exit) {
+    while (true) { // exit is read under requestMutex below
 
         std::unique_lock lk(m_asyncLoopState.requestMutex);
         if (!m_asyncLoopState.needsToProcess) // avoid a lock if a thread managed to request something already since we .unlock()ed
@@ -64,9 +79,15 @@ void CAsyncResourceGatherer::asyncAssetSpinLock() {
         for (auto& r : requests) {
             r->render();
 
-            if (r->m_impl->awaitingCv) {
+            {
+                // Under the mutex await() holds while it checks and waits: a waiter either finds
+                // awaitingEvent set or is already waiting on awaitingCv and gets notified. Setting it
+                // only when awaitingCv existed lost the wakeup of a resource that finished before
+                // await() ran, and await() then blocked forever.
+                std::lock_guard<std::mutex> lg(r->m_impl->awaitingMtx);
                 r->m_impl->awaitingEvent = true;
-                r->m_impl->awaitingCv->notify_all();
+                if (r->m_impl->awaitingCv)
+                    r->m_impl->awaitingCv->notify_all();
             }
             r->m_ready = true;
             r->m_events.finished.emit();
